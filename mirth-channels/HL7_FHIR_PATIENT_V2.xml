            <script>var mrn = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var lastName = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var firstName = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();
var dobRaw = msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;].toString();
var sexCode = msg[&apos;PID&apos;][&apos;PID.8&apos;][&apos;PID.8.1&apos;].toString();
var birthDate = dobRaw.substring(0, 4) + &quot;-&quot; + dobRaw.substring(4, 6) + &quot;-&quot; + dobRaw.substring(6, 8);
var gender = &quot;unknown&quot;;

if (sexCode == &quot;M&quot;) {

gender = &quot;male&quot;;

} else if (sexCode == &quot;F&quot;) {

gender = &quot;female&quot;;

} else if (sexCode == &quot;O&quot;) {

gender = &quot;other&quot;;

}
var patient = {
    resourceType: &quot;Patient&quot;,
    identifier: [{
    	   system: &quot;https://neema.example.org/mrn&quot;,
    	   value: mrn
    }],
    name: [{
        family: lastName,
        given: [firstName]
    }],
    birthDate: birthDate,
    gender: gender
};

channelMap.put(&apos;fhirPatient&apos;, JSON.stringify(patient));</script>
